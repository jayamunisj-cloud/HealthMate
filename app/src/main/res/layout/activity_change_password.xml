<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Page heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change Password"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#5B3CC4"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep your HealthMate account secure"
            android:textSize="14sp"
            android:textColor="#777777"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"/>

        <!-- Current password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Password"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter current password"
            android:inputType="textPassword"
            android:background="@drawable/bg_input_field"
            android:padding="16dp"
            android:singleLine="true"/>

        <!-- New password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Password"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter new password"
            android:inputType="textPassword"
            android:background="@drawable/bg_input_field"
            android:padding="16dp"
            android:singleLine="true"/>

        <!-- Confirm password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm New Password"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Re-enter new password"
            android:inputType="textPassword"
            android:background="@drawable/bg_input_field"
            android:padding="16dp"
            android:singleLine="true"/>

        <!-- Password guidance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use a unique password with at least 12 characters."
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="16dp"/>

        <!-- Change password button -->
        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Update Password"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6C4AD2"
            android:layout_marginTop="32dp"/>

        <!-- Cancel -->
        <TextView
            android:id="@+id/tvCancelPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textSize="15sp"
            android:textColor="#6C4AD2"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="0dp"/>

    </LinearLayout>
</ScrollView>
